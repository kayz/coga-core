{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coga.dev/schemas/factory/operations/v0.1/factory-task.schema.json",
  "title": "COGA Factory Operations v0.1 durable task record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "spec",
    "phase",
    "attempts",
    "recoveryCount",
    "timing",
    "events"
  ],
  "properties": {
    "schemaVersion": { "const": "coga.dev/factory/operations/v0.1" },
    "kind": { "const": "FactoryTask" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt", "updatedAt", "recordDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/digest" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "recordDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryRoot",
        "workOrderPath",
        "workOrderDigest",
        "baseCommit",
        "delivery",
        "keepWorkspace",
        "maxAttempts"
      ],
      "properties": {
        "repositoryRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "workOrderPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+$"
        },
        "workOrderDigest": { "$ref": "#/$defs/digest" },
        "baseCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
        },
        "delivery": { "enum": ["local", "github"] },
        "keepWorkspace": { "type": "boolean" },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "phase": {
      "enum": ["queued", "leased", "succeeded", "failed", "cancelled"]
    },
    "attempts": { "type": "integer", "minimum": 0, "maximum": 100 },
    "recoveryCount": { "type": "integer", "minimum": 0, "maximum": 100 },
    "nextAttemptAt": { "$ref": "#/$defs/timestamp" },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workerId", "acquiredAt", "heartbeatAt", "expiresAt"],
      "properties": {
        "id": { "$ref": "#/$defs/safeIdentifier" },
        "workerId": { "$ref": "#/$defs/safeIdentifier" },
        "acquiredAt": { "$ref": "#/$defs/timestamp" },
        "heartbeatAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enqueuedAt"],
      "properties": {
        "enqueuedAt": { "$ref": "#/$defs/timestamp" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" },
        "runDurationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "workOrderId", "baseCommit", "targets"],
      "properties": {
        "status": { "enum": ["completed", "partial", "failed"] },
        "workOrderId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "baseCommit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targets": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/completedTarget" },
              { "$ref": "#/$defs/failedTarget" }
            ]
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "occurredAt"],
      "properties": {
        "kind": { "enum": ["transient", "permanent", "isolation"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "occurredAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "type", "at", "digest"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "type": {
            "enum": [
              "enqueued",
              "leased",
              "heartbeat",
              "recovered",
              "retry-scheduled",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "at": { "$ref": "#/$defs/timestamp" },
          "previousDigest": { "$ref": "#/$defs/digest" },
          "digest": { "$ref": "#/$defs/digest" },
          "workerId": { "$ref": "#/$defs/safeIdentifier" },
          "leaseId": { "$ref": "#/$defs/safeIdentifier" },
          "detail": { "type": "string", "minLength": 1, "maxLength": 16384 }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "exactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "completedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "application",
        "baseCommit",
        "resultCommit",
        "branch",
        "evidencePath",
        "evidenceDigest"
      ],
      "properties": {
        "status": { "const": "completed" },
        "application": { "$ref": "#/$defs/exactReference" },
        "baseCommit": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "resultCommit": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "branch": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidencePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "pullRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "url", "state", "draft", "author"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "url": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "state": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "draft": { "type": "boolean" },
            "author": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      }
    },
    "failedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "application", "branch", "failure"],
      "properties": {
        "status": { "const": "failed" },
        "application": { "$ref": "#/$defs/exactReference" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "failure": { "type": "string", "minLength": 1, "maxLength": 16384 }
      }
    }
  }
}
