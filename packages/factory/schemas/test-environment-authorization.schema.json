{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coga.dev/schemas/factory/operations/v0.1/test-environment-authorization.schema.json",
  "title": "COGA Factory Test Environment Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "metadata", "subject", "decision"],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 201,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "semver": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "exactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "coga.dev/factory/operations/v0.1" },
    "kind": { "const": "TestEnvironmentAuthorization" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "issuedAt", "expiresAt", "authorizationDigest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "authorizationDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "tag",
        "commit",
        "defaultBranch",
        "environment",
        "releaseManifest"
      ],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "version": { "$ref": "#/$defs/semver" },
        "tag": { "type": "string", "minLength": 2, "maxLength": 101 },
        "commit": { "$ref": "#/$defs/commit" },
        "defaultBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?![./])(?!.*(?:\\.\\.|//|@\\{|\\\\|[~^:?*\\[\\]\\u0000-\\u001f\\u007f]))(?!.*[./]$).+$"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "releaseManifest": { "$ref": "#/$defs/fileReference" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "authorizedApprovers",
        "approvalMarker",
        "requireSignedAnnotatedTag",
        "requireDefaultBranchTip"
      ],
      "properties": {
        "policy": { "$ref": "#/$defs/exactReference" },
        "authorizedApprovers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,98}[A-Za-z0-9])?$"
          }
        },
        "approvalMarker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "requireSignedAnnotatedTag": { "const": true },
        "requireDefaultBranchTip": { "const": true }
      }
    }
  }
}
