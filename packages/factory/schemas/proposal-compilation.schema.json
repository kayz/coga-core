{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coga.dev/schemas/factory/v0.2/proposal-compilation.schema.json",
  "title": "COGA Proposal Compilation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "subject",
    "generator",
    "output"
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitBase": {
      "oneOf": [
        { "const": "work-order-commit" },
        { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "exactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "coga.dev/factory/v0.2" },
    "kind": { "const": "ProposalCompilation" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseCommit", "change", "application", "inputPaths"],
      "properties": {
        "baseCommit": { "$ref": "#/$defs/gitBase" },
        "change": { "$ref": "#/$defs/exactReference" },
        "application": { "$ref": "#/$defs/exactReference" },
        "inputPaths": {
          "type": "array",
          "minItems": 4,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model", "prompt", "tools", "budget"],
      "properties": {
        "adapter": { "$ref": "#/$defs/exactReference" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "id", "version"],
          "properties": {
            "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "version": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "path", "digest"],
          "properties": {
            "template": { "$ref": "#/$defs/exactReference" },
            "path": { "$ref": "#/$defs/relativePath" },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "network", "filesystem"],
          "properties": {
            "allowed": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 100 }
            },
            "network": { "enum": ["none", "model-provider-only"] },
            "filesystem": { "const": "read-only" }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxInputTokens",
            "maxOutputTokens",
            "maxToolCalls",
            "timeoutMs"
          ],
          "properties": {
            "maxInputTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patchPath", "receiptPath", "allowedPaths"],
      "properties": {
        "patchPath": { "$ref": "#/$defs/relativePath" },
        "receiptPath": { "$ref": "#/$defs/relativePath" },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  }
}
