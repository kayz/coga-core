{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coga.dev/schemas/factory/operations/v0.1/platform-evidence.schema.json",
  "title": "COGA Factory WeChat Platform Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "metadata", "subject", "checks"],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "exactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "coga.dev/factory/operations/v0.1" },
    "kind": { "const": "PlatformEvidence" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt", "evidenceDigest"],
      "properties": {
        "generatedAt": { "type": "string", "format": "date-time" },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "candidateCommit",
        "platform",
        "buildArtifact"
      ],
      "properties": {
        "application": { "$ref": "#/$defs/exactReference" },
        "candidateCommit": { "$ref": "#/$defs/commit" },
        "platform": { "const": "wechat-miniprogram" },
        "buildArtifact": { "$ref": "#/$defs/fileReference" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "status", "operator", "observedAt", "evidence"],
        "properties": {
          "kind": {
            "enum": [
              "devtools-compile",
              "simulator",
              "physical-device",
              "screen-reader"
            ]
          },
          "status": { "const": "passed" },
          "operator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "observedAt": { "type": "string", "format": "date-time" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "$ref": "#/$defs/fileReference" }
          }
        }
      }
    }
  }
}
