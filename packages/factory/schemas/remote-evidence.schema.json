{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coga.dev/schemas/factory/v0.3/remote-evidence.schema.json",
  "title": "COGA Factory Remote Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "subject",
    "checks",
    "attestation",
    "approvals",
    "promotion"
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "exactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": "coga.dev/factory/v0.3" },
    "kind": { "const": "RemoteEvidence" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collectedAt", "remoteEvidenceDigest"],
      "properties": {
        "collectedAt": { "type": "string", "format": "date-time" },
        "remoteEvidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceBundle",
        "repository",
        "pullRequest",
        "pullRequestUrl",
        "pullRequestAuthor",
        "baseCommit",
        "headCommit",
        "application",
        "workOrder"
      ],
      "properties": {
        "evidenceBundle": { "$ref": "#/$defs/fileReference" },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pullRequest": { "type": "integer", "minimum": 1 },
        "pullRequestUrl": { "type": "string", "format": "uri" },
        "pullRequestAuthor": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?\\[bot\\]$"
        },
        "baseCommit": { "$ref": "#/$defs/gitObject" },
        "headCommit": { "$ref": "#/$defs/gitObject" },
        "application": { "$ref": "#/$defs/exactReference" },
        "workOrder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "digest"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"
            },
            "digest": { "$ref": "#/$defs/digest" }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "app", "conclusion", "completedAt", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "app": { "type": "string", "minLength": 1, "maxLength": 200 },
          "conclusion": { "const": "success" },
          "completedAt": { "type": "string", "format": "date-time" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "subjectDigest", "verifier"],
      "properties": {
        "verified": { "const": true },
        "subjectDigest": { "$ref": "#/$defs/digest" },
        "verifier": { "const": "gh-attestation" }
      }
    },
    "approvals": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy",
          "reviewer",
          "reviewId",
          "submittedAt",
          "commit",
          "url"
        ],
        "properties": {
          "policy": { "$ref": "#/$defs/exactReference" },
          "reviewer": { "type": "string", "minLength": 1, "maxLength": 100 },
          "reviewId": { "type": "integer", "minimum": 1 },
          "submittedAt": { "type": "string", "format": "date-time" },
          "commit": { "$ref": "#/$defs/gitObject" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "blockers"],
      "properties": {
        "eligible": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
