{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coga.dev/schemas/v0.2/common.schema.json",
  "title": "COGA Common Definitions",
  "description": "Reusable form-ready definitions for COGA 0.2 resources.",
  "$defs": {
    "stableId": {
      "title": "Stable ID",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "examples": ["domain.customer.identity"],
      "x-coga-ui": { "control": "text" }
    },
    "semver": {
      "title": "Exact semantic version",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "examples": ["0.2.0"],
      "x-coga-ui": { "control": "text" }
    },
    "lifecycle": {
      "title": "Lifecycle",
      "type": "string",
      "enum": ["draft", "candidate", "approved", "published", "deprecated"],
      "x-coga-ui": { "control": "select" }
    },
    "exactRef": {
      "title": "Exact version reference",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "locatedRef": {
      "title": "Located exact resource reference",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "version": { "$ref": "#/$defs/semver" },
        "path": {
          "type": "string",
          "minLength": 1,
          "x-coga-ui": { "control": "file" }
        }
      }
    },
    "approvalAttestation": {
      "title": "Approval attestation",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "policy", "approver", "approvedAt", "evidence"],
      "properties": {
        "type": { "const": "approval" },
        "policy": { "$ref": "#/$defs/exactRef" },
        "approver": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "metadata": {
      "title": "Resource metadata",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "version",
        "lifecycle",
        "scope",
        "visibility",
        "attestations"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "owners": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": [],
          "x-coga-ui": { "control": "tags" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "default": [],
          "x-coga-ui": { "control": "tags" }
        },
        "scope": {
          "type": "string",
          "enum": ["core", "instance", "application"],
          "x-coga-ui": { "control": "select" }
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "internal", "restricted"],
          "x-coga-ui": { "control": "select" }
        },
        "attestations": {
          "type": "array",
          "items": { "$ref": "#/$defs/approvalAttestation" },
          "default": [],
          "x-coga-ui": { "control": "evidence-list" }
        }
      }
    },
    "provenance": {
      "title": "Provenance record",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sourceType"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sourceType": {
          "type": "string",
          "enum": ["document", "standard", "expert", "system", "observation"]
        },
        "locator": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      }
    },
    "relation": {
      "title": "Artifact relation",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "depends-on",
            "refines",
            "conflicts-with",
            "supersedes",
            "implements",
            "verifies",
            "applies-to"
          ]
        },
        "target": { "$ref": "#/$defs/exactRef" },
        "note": { "type": "string" }
      }
    },
    "validation": {
      "title": "Validation record",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["scenario", "schema", "test", "review"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "passed", "failed"]
        },
        "target": { "$ref": "#/$defs/exactRef" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "validator": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "scenario" } },
            "required": ["type"]
          },
          "then": { "required": ["target"] }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["passed", "failed"] } },
            "required": ["status"]
          },
          "then": { "required": ["checkedAt", "validator", "evidence"] }
        },
        {
          "if": {
            "properties": { "status": { "const": "pending" } },
            "required": ["status"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["checkedAt"] },
                { "required": ["validator"] },
                { "required": ["evidence"] }
              ]
            }
          }
        }
      ]
    },
    "contractRef": {
      "title": "Contract reference",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "format"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "version": { "$ref": "#/$defs/semver" },
        "path": { "type": "string", "minLength": 1 },
        "format": {
          "type": "string",
          "enum": ["json-schema-2020-12", "openapi-3.1"]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "approvalRule": {
      "title": "Lifecycle approval rule",
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "policies"],
      "properties": {
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exactRef" },
          "uniqueItems": true
        }
      }
    },
    "releaseEvidenceRule": {
      "title": "Lifecycle release evidence",
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "evidence"],
      "properties": {
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
