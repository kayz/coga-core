{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coga.dev/schemas/v0.1/harness-package.schema.json",
  "title": "COGA Harness Package",
  "description": "A versioned package that groups reusable artifacts in exactly one harness layer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "metadata", "spec"],
  "properties": {
    "schemaVersion": {
      "title": "Schema version",
      "description": "Frozen COGA resource contract version.",
      "type": "string",
      "const": "coga.dev/v0.1",
      "default": "coga.dev/v0.1"
    },
    "kind": {
      "title": "Resource kind",
      "description": "Discriminator for a versioned harness package.",
      "type": "string",
      "const": "HarnessPackage",
      "default": "HarnessPackage"
    },
    "metadata": {
      "$ref": "https://coga.dev/schemas/v0.1/common.schema.json#/$defs/metadata"
    },
    "spec": {
      "title": "Harness package definition",
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "description", "dependencies", "artifacts"],
      "properties": {
        "layer": {
          "title": "Harness layer",
          "description": "The knowledge boundary owned by this package.",
          "type": "string",
          "enum": [
            "domain",
            "platform",
            "engineering",
            "organization",
            "operations"
          ],
          "x-coga-ui": {
            "control": "select"
          }
        },
        "description": {
          "title": "Description",
          "description": "Human-readable package purpose and boundary.",
          "type": "string",
          "minLength": 1,
          "x-coga-ui": {
            "control": "markdown"
          }
        },
        "dependencies": {
          "title": "Package dependencies",
          "description": "Other harness packages required at exact versions.",
          "type": "array",
          "items": {
            "$ref": "https://coga.dev/schemas/v0.1/common.schema.json#/$defs/exactRef"
          },
          "uniqueItems": true,
          "default": [],
          "x-coga-ui": {
            "control": "dependency-list"
          }
        },
        "artifacts": {
          "title": "Owned artifacts",
          "description": "Canonical artifact files owned by this exact package version.",
          "type": "array",
          "items": {
            "$ref": "https://coga.dev/schemas/v0.1/common.schema.json#/$defs/locatedRef"
          },
          "uniqueItems": true,
          "default": [],
          "x-coga-ui": {
            "control": "resource-list"
          }
        }
      }
    }
  }
}
