{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coga:factory:agent-evaluation-profile:0.1.0",
  "title": "COGA agent evaluation profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "metadata", "spec"],
  "properties": {
    "schemaVersion": {
      "const": "coga.dev/factory/v0.1"
    },
    "kind": {
      "const": "AgentEvaluationProfile"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterRef",
        "providerBinding",
        "prompt",
        "inputPolicy",
        "output",
        "authority",
        "evidenceBinding"
      ],
      "properties": {
        "adapterRef": {
          "$ref": "#/$defs/adapterRef"
        },
        "providerBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "runtimeOverride", "secretRef"],
          "properties": {
            "provider": {
              "const": "deepseek"
            },
            "model": {
              "const": "deepseek-v4-pro"
            },
            "runtimeOverride": {
              "type": "object",
              "additionalProperties": false,
              "required": ["allowed", "requireRecordedProviderAndModel"],
              "properties": {
                "allowed": {
                  "const": true
                },
                "requireRecordedProviderAndModel": {
                  "const": true
                }
              }
            },
            "secretRef": {
              "const": "env://DEEPSEEK_API_KEY"
            }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "version", "digestRequired"],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "version": {
              "$ref": "#/$defs/semver"
            },
            "digestRequired": {
              "const": true
            }
          }
        },
        "inputPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourcePolicy",
            "acceptedMaterials",
            "sourceExcerptsOnly",
            "sourceDigestsRequired",
            "defaultClassification",
            "restrictedInput"
          ],
          "properties": {
            "sourcePolicy": {
              "$ref": "#/$defs/path"
            },
            "acceptedMaterials": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "candidate",
                  "semantic-diff",
                  "source-excerpts",
                  "scenario-index"
                ]
              }
            },
            "sourceExcerptsOnly": {
              "const": true
            },
            "sourceDigestsRequired": {
              "const": true
            },
            "defaultClassification": {
              "const": "public"
            },
            "restrictedInput": {
              "const": "deny"
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "requiredFields"],
          "properties": {
            "schema": {
              "$ref": "#/$defs/path"
            },
            "requiredFields": {
              "const": [
                "summary",
                "changeClasses",
                "risks",
                "questions",
                "recommendedScenarios",
                "recommendation",
                "confidence"
              ]
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mayRecommend",
            "mayCreateCandidateEvidence",
            "mayApprove",
            "mayPublish",
            "selfApproval"
          ],
          "properties": {
            "mayRecommend": {
              "const": true
            },
            "mayCreateCandidateEvidence": {
              "const": true
            },
            "mayApprove": {
              "const": false
            },
            "mayPublish": {
              "const": false
            },
            "selfApproval": {
              "const": "deny"
            }
          }
        },
        "evidenceBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "schemaVersion",
            "disposition",
            "recordPromptDigest",
            "recordOutputDigest",
            "retainRawReasoning"
          ],
          "properties": {
            "kind": {
              "const": "EvidenceBundle"
            },
            "schemaVersion": {
              "const": "coga.dev/control/v0.1"
            },
            "disposition": {
              "const": "candidate"
            },
            "recordPromptDigest": {
              "const": true
            },
            "recordOutputDigest": {
              "const": true
            },
            "retainRawReasoning": {
              "const": false
            }
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "adapterRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {
          "const": "agent"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\]).+$"
    }
  }
}
