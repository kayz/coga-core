{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coga:example:contract:content-item:0.1.0",
  "title": "Fictitious financial content item",
  "description": "A sanitized example contract shape, not a production or proprietary API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contentRef",
    "classification",
    "sourceLabel",
    "observedAt",
    "freshness",
    "disclosure"
  ],
  "properties": {
    "contentRef": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": ["educational", "market-context", "service-summary"]
    },
    "sourceLabel": {
      "type": "string"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "freshness": {
      "type": "string",
      "enum": ["current", "stale", "unavailable"]
    },
    "disclosure": {
      "type": "string"
    }
  }
}
