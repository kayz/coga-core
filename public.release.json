{
  "schemaVersion": "coga.dev/public-release/v0.2",
  "version": "0.2.0",
  "allow": [
    ".gitattributes",
    ".prettierignore",
    ".coga/",
    ".github/",
    ".gitignore",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "VISION.md",
    "VISION.zh-CN.md",
    "设计方案及差异.md",
    "本次项目调整.md",
    "docs/",
    "examples/broker-digital-channel/",
    "package-lock.json",
    "package.json",
    "packages/core/",
    "packages/factory/",
    "public.release.json",
    "scripts/",
    "tsconfig.base.json"
  ],
  "deny": [".local/", "private/"],
  "contentPolicy": {
    "maxCandidateBytes": 52428800,
    "text": {
      "maxFileBytes": 2097152,
      "extensions": [
        ".cjs",
        ".css",
        ".csv",
        ".html",
        ".js",
        ".json",
        ".md",
        ".mjs",
        ".patch",
        ".svg",
        ".ts",
        ".tsv",
        ".txt",
        ".wxml",
        ".wxss",
        ".xml",
        ".yaml",
        ".yml"
      ],
      "files": [
        ".gitattributes",
        ".gitignore",
        ".prettierignore",
        "LICENSE",
        "packages/core/LICENSE",
        "packages/factory/LICENSE"
      ]
    },
    "binary": {
      "maxFileBytes": 10485760,
      "extensions": {
        ".gif": "gif",
        ".jpeg": "jpeg",
        ".jpg": "jpeg",
        ".pdf": "pdf",
        ".png": "png",
        ".webp": "webp"
      }
    }
  }
}
